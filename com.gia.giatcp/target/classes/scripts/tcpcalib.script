# GIA TCP Calibration - minimal realtime probe.
# The ONLY things done on the robot: moveC circles + reading the sensor inputs +
# capturing get_actual_tcp_pose() at each edge + the Z search. NO maths here:
# the raw poses are streamed back to Java, which does all the geometry
# (so the same maths is reusable for other robots, e.g. Estun).

def tcpc__getInput(n):
  if (n >= 10):
    return get_configurable_digital_in(n % 10)
  else:
    return get_standard_digital_in(n)
  end
end

tcpc__plist1 = [p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0]]
tcpc__plist2 = [p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0],p[0,0,0,0,0,0]]
tcpc__count1 = 0
tcpc__count2 = 0
tcpc__in1 = 0
tcpc__in2 = 0

def tcpc__rec(no):
  if (no == 1):
    if (tcpc__count1 < 8):
      tcpc__plist1[tcpc__count1] = get_actual_tcp_pose()
      tcpc__count1 = tcpc__count1 + 1
    end
  else:
    if (tcpc__count2 < 8):
      tcpc__plist2[tcpc__count2] = get_actual_tcp_pose()
      tcpc__count2 = tcpc__count2 + 1
    end
  end
end

def tcpc__trigHigh(in, flag, no):
  if (tcpc__getInput(in) and (not flag)):
    tcpc__rec(no)
    return True
  end
  return flag
end

def tcpc__trigLow(in, flag, no):
  if ((not tcpc__getInput(in)) and flag):
    tcpc__rec(no)
    return False
  end
  return flag
end

thread tcpc__edgeThread():
  local f1 = False
  local f2 = False
  # wait until both inputs are low (tool clear of the beams)
  while (tcpc__getInput(tcpc__in1) or tcpc__getInput(tcpc__in2)):
    sync()
  end
  while True:
    enter_critical
    f1 = tcpc__trigHigh(tcpc__in1, f1, 1)
    f1 = tcpc__trigLow(tcpc__in1, f1, 1)
    f2 = tcpc__trigHigh(tcpc__in2, f2, 2)
    f2 = tcpc__trigLow(tcpc__in2, f2, 2)
    exit_critical
    sync()
  end
end

def tcpc__circlePoints(pos, radius, overrun):
  local r = radius/1000
  local ox = cos(d2r(overrun)) * r
  local oy = sin(d2r(overrun)) * r
  return [pose_trans(pos, p[r,0,0,0,0,0]), pose_trans(pos, p[0,r,0,0,0,0]), pose_trans(pos, p[-r,0,0,0,0,0]), pose_trans(pos, p[0,-r,0,0,0,0]), pose_trans(pos, p[ox,oy,0,0,0,0])]
end

def tcpc__poseStr(pz):
  return to_str(pz[0]) + "," + to_str(pz[1]) + "," + to_str(pz[2]) + "," + to_str(pz[3]) + "," + to_str(pz[4]) + "," + to_str(pz[5])
end

def tcpc__send(host, port, msg):
  socket_open(host, port, "tcpc")
  socket_send_string(msg, "tcpc")
  socket_send_byte(10, "tcpc")
  socket_close("tcpc")
end

# Move to pStart, run one probe circle capturing edges, and build the reply:
#   "C;count1;count2;<l1_0>;<l1_1>;<l1_2>;<l1_3>;<l2_0>;<l2_1>;<l2_2>;<l2_3>"
# where each <pose> is "x,y,z,rx,ry,rz". Java validates the counts and does the maths.
# Returns the message string (the caller decides over which socket to send it).
def tcpc__circleMsg(pStart, in1, in2, radius, acc, vel, overrun):
  tcpc__in1 = in1
  tcpc__in2 = in2
  tcpc__count1 = 0
  tcpc__count2 = 0
  local pts = tcpc__circlePoints(pStart, radius, overrun)
  local blend = (radius/1000) * .5
  movel(pts[0], a=acc, v=vel)
  local h = run tcpc__edgeThread()
  movep(pts[0], a=acc, v=vel, r=blend)
  movec(pts[1], pts[2], a=acc, v=vel, r=blend)
  movec(pts[3], pts[0], a=acc, v=vel, r=.001)
  movep(pts[4], a=acc, v=vel)
  kill h
  # No hop back to pStart (CAPTRON legacy): the next primitive (search Z / next circle)
  # starts with its own movel, so the return leg only added travel.
  local msg = "C;" + to_str(tcpc__count1) + ";" + to_str(tcpc__count2)
  local i = 0
  while (i < 4):
    msg = msg + ";" + tcpc__poseStr(tcpc__plist1[i])
    i = i + 1
  end
  i = 0
  while (i < 4):
    msg = msg + ";" + tcpc__poseStr(tcpc__plist2[i])
    i = i + 1
  end
  return msg
end

# Live path: probe one circle and send the reply over a fresh socket (one secondary program).
def tcpc__runCircle(pStart, in1, in2, radius, acc, vel, overrun, host, port):
  tcpc__send(host, port, tcpc__circleMsg(pStart, in1, in2, radius, acc, vel, overrun))
end

# Move thread for the Z search (so we can poll the inputs while moving).
tcpc__mPos = p[0,0,0,0,0,0]
tcpc__mAcc = 0
tcpc__mVel = 0
tcpc__mStatus = 0
thread tcpc__moveThread():
  enter_critical
  tcpc__mStatus = 1
  movel(tcpc__mPos, a=tcpc__mAcc, v=tcpc__mVel)
  tcpc__mStatus = 2
  exit_critical
end

# Move to pCenter, retract until both inputs are low, then immerse in the opposite
# direction until both are high. Build "Z;<pose>" (beam plane) or "Z;FAIL;<reason>"
# where <reason> is LOW (inputs low at the intersect: bad teach/TCP/tool), SEARCH
# (retract never freed the beams) or IMMERSE (immerse never re-cut them) - Java maps
# them to distinct statuses (CAPTRON codes 4/5/31).
# Ends with the tip re-placed midway between the release edge (retract) and the cut
# edge (immerse), i.e. right between the two beams even if they are not coplanar.
def tcpc__searchZMsg(pCenter, in1, in2, zSearch, zImmerse, acc, vel):
  movel(pCenter, a=acc, v=vel)
  if (not (tcpc__getInput(in1) and tcpc__getInput(in2))):
    # CAPTRON "input low on intersect position": at the true centre the tool MUST cut
    # both beams. If it does not (wrong teach depth, wrong tool, sensor polarity), abort
    # instead of searching from a meaningless start.
    return "Z;FAIL;LOW"
  end
  tcpc__mPos = pose_trans(pCenter, p[0,0,-(zSearch/1000),0,0,0])
  tcpc__mAcc = acc
  tcpc__mVel = vel
  tcpc__mStatus = 0
  local h = run tcpc__moveThread()
  local found = False
  local pRel = p[0,0,0,0,0,0]
  while True:
    if ((not tcpc__getInput(in1)) and (not tcpc__getInput(in2))):
      pRel = get_actual_tcp_pose()
      sleep(0.04)
      kill h
      stopl(2.0)
      found = True
      break
    elif (tcpc__mStatus > 1):
      kill h
      break
    end
    sync()
  end
  if (not found):
    return "Z;FAIL;SEARCH"
  end
  tcpc__mPos = pose_trans(pCenter, p[0,0,(zImmerse/1000),0,0,0])
  tcpc__mAcc = acc * .2
  tcpc__mVel = vel * .2
  tcpc__mStatus = 0
  h = run tcpc__moveThread()
  while True:
    if (tcpc__getInput(in1) and tcpc__getInput(in2)):
      sleep(0.04)
      local pz = get_actual_tcp_pose()
      kill h
      stopl(2.0)
      # Final placement (CAPTRON re-places the tip at the beam plane at the end of
      # its live flow): rise from the cut edge to halfway towards the release edge,
      # leaving the wire tip right between the beams. The measured pose sent to
      # Java is still the cut edge, so the Z correction semantics do not change.
      movel(interpolate_pose(pz, pRel, 0.5), a=acc, v=vel*.2)
      return "Z;" + tcpc__poseStr(pz)
    elif (tcpc__mStatus > 1):
      kill h
      stopl(2.0)
      return "Z;FAIL;IMMERSE"
    end
    sync()
  end
  return "Z;FAIL;IMMERSE"
end

# Live path: search Z and send the reply over a fresh socket (one secondary program).
def tcpc__runSearchZ(pCenter, in1, in2, zSearch, zImmerse, acc, vel, host, port):
  tcpc__send(host, port, tcpc__searchZMsg(pCenter, in1, in2, zSearch, zImmerse, acc, vel))
end

# Light check (CAPTRON Check / cap_immerseZ): go to the referenced pose and verify the
# tool still cuts both beams. If not, immerse slowly up to zImmerse to forgive minimal
# wear (a slightly shorter tool leaves the tip just above the beam plane); only if the
# beams are never cut the tool is considered lost/bent. NO probing and NO server: this
# is the fast between-welds action. Returns a status matching the Java enum ordinals:
# 0 = OK, 6 = INPUT_LOW_AT_CENTER, 7 = IMMERSE_FAILED.
def tcpc__lightCheck(pRef, in1, in2, zImmerse, acc, vel):
  movel(pRef, a=acc, v=vel)
  if (tcpc__getInput(in1) and tcpc__getInput(in2)):
    return 0
  end
  tcpc__mPos = pose_trans(pRef, p[0,0,(zImmerse/1000),0,0,0])
  tcpc__mAcc = acc * .2
  tcpc__mVel = vel * .2
  tcpc__mStatus = 0
  local h = run tcpc__moveThread()
  while True:
    if (tcpc__getInput(in1) and tcpc__getInput(in2)):
      sleep(0.04)
      kill h
      stopl(2.0)
      if (tcpc__getInput(in1) and tcpc__getInput(in2)):
        return 0
      end
      return 6
    elif (tcpc__mStatus > 1):
      kill h
      return 7
    end
    sync()
  end
  return 7
end

# ---------------------------------------------------------------------------
# Runtime path: the running welding program calibrates the TCP by talking to the
# persistent Java CalibrationServer over one socket. The server directs each step
# (op 1 = probe circle, 2 = search Z, 0 = done) and does ALL the geometry.
# Results land in these globals for the rest of the program to use.
# ---------------------------------------------------------------------------
tcpc__rtStatus = -1
tcpc__rtTcp = p[0,0,0,0,0,0]
tcpc__rtDiam = 0.0

def tcpc__rtSend(msg):
  socket_send_string(msg, "giatcp")
  socket_send_byte(10, "giatcp")
end

def tcpc__rtCalib(host, port, initLine, in1, in2, radius, acc, vel, overrun, zSearch, zImmerse):
  tcpc__rtStatus = 1   # NO_ROBOT_REPLY until the server hands back a result
  tcpc__rtTcp = p[0,0,0,0,0,0]
  tcpc__rtDiam = 0.0
  if (not socket_open(host, port, "giatcp")):
    return False
  end
  tcpc__rtSend(initLine)
  local done = False
  local misses = 0
  # 6 x 10 s: the server computes in milliseconds, so waiting longer only makes sense
  # when it is down (URCap not loaded) - fail within a minute instead of five.
  while ((not done) and (misses < 6)):
    local m = socket_read_ascii_float(9, "giatcp", 10)
    if (m[0] == 9):
      misses = 0
      local op = m[1]
      local pose = p[m[2],m[3],m[4],m[5],m[6],m[7]]
      if (op == 1):
        tcpc__rtSend(tcpc__circleMsg(pose, in1, in2, radius, acc, vel, overrun))
      elif (op == 2):
        tcpc__rtSend(tcpc__searchZMsg(pose, in1, in2, zSearch, zImmerse, acc, vel))
      else:
        tcpc__rtStatus = m[8]
        tcpc__rtTcp = pose
        tcpc__rtDiam = m[9]
        done = True
      end
    else:
      misses = misses + 1
    end
  end
  socket_close("giatcp")
  return done
end

# ---------------------------------------------------------------------------
# Public helpers (CAPTRON cap_* parity): call them from program expressions,
# If conditions or script nodes after a GIA TCP action. ASCII-only strings.
# ---------------------------------------------------------------------------
def gia_isActionOk():
  return (tcpc__rtStatus == 0)
end

def gia_getStatus():
  return tcpc__rtStatus
end

def gia_getTCP():
  return tcpc__rtTcp
end

def gia_getDiameterMM():
  return tcpc__rtDiam
end

# Applies the last corrected TCP (only if the action ended OK). Returns True on apply.
def gia_activateTCP():
  if (tcpc__rtStatus == 0):
    set_tcp(tcpc__rtTcp)
    return True
  end
  return False
end

def gia_getStatusMsg():
  if (tcpc__rtStatus == 0):
    return "OK"
  elif (tcpc__rtStatus == 1):
    return "Sin respuesta del robot / no robot reply"
  elif (tcpc__rtStatus == 2):
    return "El circulo no cruzo ambos haces / no intersect"
  elif (tcpc__rtStatus == 3):
    return "Busqueda Z fallida / search Z failed"
  elif (tcpc__rtStatus == 4):
    return "Fuera de tolerancia / out of tolerance"
  elif (tcpc__rtStatus == 5):
    return "Orientacion no posible / orientation not possible"
  elif (tcpc__rtStatus == 6):
    return "No corta ambos haces en la referencia / input low at reference"
  elif (tcpc__rtStatus == 7):
    return "Inmersion fallida: herramienta desgastada o ausente / immerse failed"
  end
  return "Estado " + to_str(tcpc__rtStatus)
end
